		lineageTag: ced93820-1622-40e5-8b5d-195fe5ceaad7
		summarizeBy: none
		sourceColumn: On View

	/// Catalogued status as readable Yes / No / Unknown (from the raw Y/N flag).
	column 'Cataloged Status'
		dataType: string
		lineageTag: 80aca084-d2f7-4f6f-90ff-4cd49e31e847
		summarizeBy: none
		sourceColumn: Cataloged Status

	partition Artworks = m
		mode: import
		source =
				let
				    // Load the raw MoMA artworks export; every field starts as text
				    Source = Csv.Document(File.Contents("C:\Users\msala\Data\app_store\data_analysis\MoMA+Art+Collection\Artworks.csv"),[Delimiter=",", Columns=30, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Column Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    // Apply base data types: text fields, the acquisition date, the object key and the reliably numeric size columns
				    #"Changed Base Types" = Table.TransformColumnTypes(#"Promoted Column Headers",{{"Title", type text}, {"Artist", type text}, {"ConstituentID", type text}, {"ArtistBio", type text}, {"Nationality", type text}, {"BeginDate", type text}, {"EndDate", type text}, {"Gender", type text}, {"Date", type text}, {"Medium", type text}, {"Dimensions", type text}, {"CreditLine", type text}, {"AccessionNumber", type text}, {"Classification", type text}, {"Department", type text}, {"DateAcquired", type date}, {"Cataloged", type text}, {"ObjectID", Int64.Type}, {"URL", type text}, {"ImageURL", type text}, {"OnView", type text}, {"Circumference (cm)", type number}, {"Depth (cm)", type number}, {"Diameter (cm)", type number}, {"Height (cm)", type number}, {"Length (cm)", type number}, {"Weight (kg)", type number}, {"Width (cm)", type number}, {"Seat Height (cm)", type number}, {"Duration (sec.)", type number}}),
				    // Trim whitespace and fill blank category labels so charts have no empty axis members
				    #"Cleaned Category Text" = Table.TransformColumns(#"Changed Base Types", {
				        {"Classification", each let v = Text.Trim(_ ?? "") in if v = "" then "Unclassified" else v, type text},
				        {"Department", each let v = Text.Trim(_ ?? "") in if v = "" then "Unassigned" else v, type text},
				        {"Title", each Text.Trim(_ ?? ""), type text},
				        {"Artist", each Text.Trim(_ ?? ""), type text}
				    }),
				    // Pull the primary nationality out of the parenthesised (sometimes repeated) raw value
				    #"Added Primary Nationality" = Table.AddColumn(#"Cleaned Category Text", "Primary Nationality", each
				        let raw = Text.Trim(Text.BetweenDelimiters([Nationality] ?? "", "(", ")"))
				        in if raw = "" or Text.Lower(raw) = "nationality unknown" then "Unknown" else Text.Proper(raw), type text),
				    // Normalise the parenthesised gender value into a small, readable set
				    #"Added Artist Gender" = Table.AddColumn(#"Added Primary Nationality", "Artist Gender", each
				        let g = Text.Lower(Text.Trim(Text.BetweenDelimiters([Gender] ?? "", "(", ")")))
				        in if Text.StartsWith(g, "female") then "Female"
				           else if Text.StartsWith(g, "male") then "Male"
				           else if g = "" then "Unknown"
				           else "Non-binary / Other", type text),
				    // Read the first plausible four-digit year (1000-2026) out of the free-text creation Date
				    #"Added Year Created" = Table.AddColumn(#"Added Artist Gender", "Year Created", each
				        let
				            s = [Date] ?? "",
				            n = Text.Length(s),
				            windows = if n < 4 then {} else List.Transform({0..n - 4}, (i) => Text.Range(s, i, 4)),
				            candidates = List.Transform(windows, (w) => if Text.Select(w, {"0".."9"}) = w then Number.FromText(w) else null),
				            years = List.Select(candidates, (y) => y <> null and y >= 1000 and y <= 2026)
				        in if List.Count(years) = 0 then null else List.First(years), Int64.Type),
				    // Derive the decade of creation (e.g. 1967 -> 1960)
				    #"Added Decade Created" = Table.AddColumn(#"Added Year Created", "Decade Created", each
				        if [Year Created] = null then null else Number.IntegerDivide([Year Created], 10) * 10, Int64.Type),
				    // Derive the acquisition year from the acquisition date
				    #"Added Year Acquired" = Table.AddColumn(#"Added Decade Created", "Year Acquired", each
				        if [DateAcquired] = null then null else Date.Year([DateAcquired]), Int64.Type),
				    // Flag whether the artwork is currently on display (OnView holds a gallery location when it is)
				    #"Added On View" = Table.AddColumn(#"Added Year Acquired", "On View", each
				        if Text.Trim([OnView] ?? "") = "" then "No" else "Yes", type text),
				    // Turn the raw catalogued Y/N flag into readable labels
				    #"Added Cataloged Status" = Table.AddColumn(#"Added On View", "Cataloged Status", each
				        if [Cataloged] = "Y" then "Yes" else if [Cataloged] = "N" then "No" else "Unknown", type text)
				in
				    #"Added Cataloged Status"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

