table Artworks
	lineageTag: 90ae3eba-650d-4a59-a8da-5b7d83419159

	/// Number of artworks (rows) in the current filter context.
	measure '# Artworks' = COUNTROWS('Artworks')
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 77bbfe57-18ba-4b3e-ac3c-422c16f69af9

	/// Number of artworks currently on display in the museum.
	measure '# On View' = CALCULATE([# Artworks], 'Artworks'[On View] = "Yes")
		formatString: #,##0
		displayFolder: Counts
		lineageTag: f5b970de-bd76-4766-b112-765546aaa23d

	/// Share of artworks in context that are currently on display.
	measure '% On View' = DIVIDE([# On View], [# Artworks])
		formatString: 0.0%
		displayFolder: Ratios
		lineageTag: 24d8afb9-1572-4684-a3c4-1f88df893098

	/// Number of artworks that have been catalogued in MoMA's collection system.
	measure '# Cataloged' = CALCULATE([# Artworks], 'Artworks'[Cataloged Status] = "Yes")
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 97498312-fbde-43ff-962d-f3431bf931d2

	/// Share of artworks in context that have been catalogued.
	measure '% Cataloged' = DIVIDE([# Cataloged], [# Artworks])
		formatString: 0.0%
		displayFolder: Ratios
		lineageTag: c3df885b-2c71-41dc-a58d-9de634ef07f4

