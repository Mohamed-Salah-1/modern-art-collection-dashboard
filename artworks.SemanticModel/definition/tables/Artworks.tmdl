		summarizeBy: none
		sourceColumn: Artist Gender

	/// Four-digit creation year parsed from the free-text Date field. Null when no year could be identified (e.g. "n.d.", "late 19th century").
	column 'Year Created'
		dataType: int64
		formatString: 0
		lineageTag: a137a74d-81ee-43a9-abdf-c2c90a59f32d
		summarizeBy: none
		sourceColumn: Year Created

	/// Decade of creation derived from Year Created (e.g. 1967 -> 1960).
	column 'Decade Created'
